            "disableBodyPruning": true
          },
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\r\n    \"email\": \"your_email123@printway.io\", // Enter your email\r\n    \"password\": \"YourPassword@123\" // Enter your password\r\n}",
