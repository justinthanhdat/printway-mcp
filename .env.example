PORT=3000
PUBLIC_URL=http://localhost:3000
# Obtain from Printway: Store > Connect APIs > Generate Token
PRINTWAY_ACCESS_TOKEN=
PRINTWAY_REFRESH_TOKEN=
PRINTWAY_ENV=production
# Password entered ONLY in the OAuth browser login form.
MCP_LOGIN_PASSWORD=replace-with-a-long-random-secret
# Optional server-side credentials for token administration tools.
PRINTWAY_EMAIL=
PRINTWAY_PASSWORD=
ENABLE_AUTH_ADMIN=false
